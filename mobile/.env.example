# Must end in /api; no tokens or secrets in EXPO_PUBLIC_* variables.
# Physical Android/iPhone on the same Wi-Fi: use your backend computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
# Android Studio emulator: http://10.0.2.2:8000/api
# iOS simulator on the backend Mac: http://localhost:8000/api
# Remote device via your own HTTPS backend tunnel: https://YOUR-HOST/api
