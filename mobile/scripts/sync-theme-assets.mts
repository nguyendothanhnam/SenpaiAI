// ESM entry point so tsx can use top-level await without changing app module mode.
import { copyFile, mkdir, stat, writeFile } from 'node:fs/promises'
import { fileURLToPath } from 'node:url'
import { themes, themeBackgrounds } from '../../frontend/src/themes/themes'

const root = new URL('../', import.meta.url)
const web = new URL('../../frontend/public/', import.meta.url)
const images = [...new Set([...themeBackgrounds.map(item => item.image), ...Object.values(themes).flatMap(theme => [...Object.values(theme.background), ...(theme.mascot ? [theme.mascot] : [])])].filter(Boolean))]
await mkdir(new URL('assets/themes/', root), { recursive: true })
const imports: string[] = [], entries: string[] = [], report: { path: string; bytes?: number; missing?: boolean }[] = []
for (const [index, path] of images.entries()) {
  const source = new URL(path.replace(/^\//, ''), web)
  let size: number
  try { size = (await stat(source)).size } catch { report.push({ path, missing: true }); continue }
  const filename = path.slice('/themes/'.length).replaceAll('/', '-')
  await copyFile(source, new URL(`assets/themes/${filename}`, root))
  imports.push(`import image${index} from '../../assets/themes/${filename}'`)
  entries.push(`  ${JSON.stringify(path)}: image${index},`)
  report.push({ path, bytes: size })
}
await writeFile(new URL('src/theme/assets.ts', root), `// Generated by scripts/sync-theme-assets.mts from shared web definitions.\nimport type { ImageSourcePropType } from 'react-native'\n${imports.join('\n')}\nexport const themeImages: Record<string, ImageSourcePropType> = {\n${entries.join('\n')}\n}\n`)
await mkdir(new URL('docs/', root), { recursive: true })
await writeFile(new URL('docs/THEME_ASSETS.json', root), JSON.stringify({ source: 'frontend/public', assets: report, packagedBytes: report.reduce((sum, item) => sum + (item.bytes || 0), 0) }, null, 2) + '\n')
console.log(`Synced ${entries.length} existing images to ${fileURLToPath(new URL('assets/themes/', root))}; missing source images are listed in docs/THEME_ASSETS.json.`)
